name: hospitaly
services:
  hospitaly.api:
    build:
      context: C:\Users\khali\RiderProjects\Hospitaly
      dockerfile: src/Api/Hospitaly.Api/Dockerfile
    container_name: Hospitaly.Api
    depends_on:
      hospitaly.keycloak:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
      ASPNETCORE_Kestrel__Certificates__Default__Password: SuperPassword
      ASPNETCORE_Kestrel__Certificates__Default__Path: /https/dev-cert.pfx
      ASPNETCORE_URLS: https://+:8081;http://+:8080
    image: hospitalyapi
    networks:
      local_network: null
    ports:
      - mode: ingress
        target: 8080
        published: "5000"
        protocol: tcp
      - mode: ingress
        target: 8081
        published: "5001"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\khali\AppData\Roaming/ASP.NET/Https
        target: /https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\khali\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\khali\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\khali\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\khali\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
  hospitaly.database:
    container_name: Hospitaly.Database
    environment:
      POSTGRES_DB: hospitaly
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    image: postgres:latest
    networks:
      local_network: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    volumes:
      - type: volume
        source: hospitaly_db
        target: /var/lib/postgresql/data
        volume: {}
  hospitaly.keycloak:
    command:
      - start-dev
      - --http-port
      - "7080"
      - --https-port
      - "7443"
    container_name: Hospitaly.Keycloak
    environment:
      KC_HEALTH_ENABLED: "true"
      KC_LOG_LEVEL: info
      KEYCLOAK_ADMIN: admin
      KEYCLOAK_ADMIN_PASSWORD: admin
    healthcheck:
      test:
        - CMD-SHELL
        - "exec 3<>/dev/tcp/localhost/7080 && echo -e 'GET /health/ready HTTP/1.1\r\nHost: localhost\r\n\r\n' >&3 && cat <&3 | grep -q '200 OK'"
      timeout: 5s
      interval: 15s
      retries: 10
      start_period: 1m0s
    image: quay.io/keycloak/keycloak:24.0
    networks:
      local_network: null
    ports:
      - mode: ingress
        target: 7080
        published: "7080"
        protocol: tcp
      - mode: ingress
        target: 7443
        published: "7443"
        protocol: tcp
networks:
  local_network:
    name: hospitaly_local_network
    driver: bridge
volumes:
  hospitaly_db:
    name: hospitaly_hospitaly_db