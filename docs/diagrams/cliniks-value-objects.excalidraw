      "width": 330,
      "height": 60,
      "text": "Shared VOs (from Common.Domain):\nDateTimeRange (Start, End?, IsOpenEnded,\nOverlapsWith(), Contains(), IntersectWith())",
      "fontSize": 12,
      "fontFamily": 5,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "shared-vo-note"
